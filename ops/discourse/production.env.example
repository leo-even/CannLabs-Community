# NON-SECRET EXAMPLE of the root-only host file /etc/cannlabs-community/production.env (DEC-042, ops/discourse/SECRETS.md).
# Names only: every value is a <PLACEHOLDER>. Never put a real value in this file and never commit a populated copy.
# Format: one KEY=VALUE per line, no quotes, no multi-line values, no single quote, no "<%", no leading or trailing whitespace.
# The developer-emails variable is forbidden in production and must never appear here (SECRETS.md, section 10).
DISCOURSE_SMTP_USER_NAME=<SMTP_USER_NAME>
DISCOURSE_SMTP_PASSWORD=<SMTP_PASSWORD>
DISCOURSE_SECRET_KEY_BASE=<SECRET_KEY_BASE_128_HEX>
DISCOURSE_GOOGLE_OAUTH2_CLIENT_SECRET=<GOOGLE_OAUTH2_CLIENT_SECRET>
DISCOURSE_S3_ACCESS_KEY_ID=<S3_ACCESS_KEY_ID>
DISCOURSE_S3_SECRET_ACCESS_KEY=<S3_SECRET_ACCESS_KEY>
